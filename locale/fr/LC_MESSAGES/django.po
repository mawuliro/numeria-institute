msgid "Vision & Mission"
msgstr ""

#: pages/templates/pages/a_propos.html:113
msgid "Notre Vision"
msgstr ""

#: pages/templates/pages/a_propos.html:115
msgid ""
"Devenir, d'ici 2030, le principal institut de formation en sciences "
"computationnelles et intelligence artificielle appliquée en Afrique de "
"l'Ouest francophone, produisant des experts capables de modéliser, analyser "
"et résoudre les problèmes complexes du continent."
msgstr ""

