msgid "Partagez votre expertise et aidez la nouvelle génération à réussir. Faites la différence dans la vie d'un apprenant."
msgstr "Share your expertise and help the next generation succeed. Make a difference in a learner's life."

#: mentorat/templates/mentorat/index.html
msgid "S'inscrire comme mentor"
msgstr "Register as a mentor"

#: mentorat/templates/mentorat/index.html
msgid "Se connecter pour devenir mentor"
msgstr "Log in to become a mentor"

#: mentorat/templates/mentorat/index.html
msgid "Trouver un Mentor"
msgstr "Find a Mentor"

#: mentorat/templates/mentorat/index.html
msgid "Bénéficiez de conseils personnalisés d'experts dans votre domaine. Accélérez votre apprentissage et votre carrière."
msgstr "Get personalised advice from experts in your field. Accelerate your learning and career."

#: mentorat/templates/mentorat/index.html
msgid "S'inscrire comme mentoré"
msgstr "Register as a mentee"

#: mentorat/templates/mentorat/index.html
msgid "Se connecter pour trouver un mentor"
msgstr "Log in to find a mentor"

#: mentorat/templates/mentorat/index.html
msgid "En 3 étapes"
msgstr "In 3 steps"

#: mentorat/templates/mentorat/index.html
msgid "Comment ça marche ?"
msgstr "How does it work?"

#: mentorat/templates/mentorat/index.html
msgid "Inscrivez-vous"
msgstr "Sign up"

#: mentorat/templates/mentorat/index.html
msgid "Créez votre profil de mentor ou de mentoré selon vos besoins et objectifs."
msgstr "Create your mentor or mentee profile according to your needs and goals."

#: mentorat/templates/mentorat/index.html
msgid "Connectez-vous"
msgstr "Connect"

#: mentorat/templates/mentorat/index.html
msgid "Les mentors et mentorés sont mis en relation selon leurs profils et domaines."
msgstr "Mentors and mentees are matched according to their profiles and fields."

#: mentorat/templates/mentorat/index.html
msgid "Échangez"
msgstr "Exchange"

#: mentorat/templates/mentorat/index.html
msgid "Planifiez des séances et bénéficiez de conseils personnalisés sur mesure."
msgstr "Schedule sessions and benefit from tailored personalised advice."

#: mentorat/templates/mentorat/index.html
msgid "Voir tous les mentors disponibles"
msgstr "View all available mentors"
